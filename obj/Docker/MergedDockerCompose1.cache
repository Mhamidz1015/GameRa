name: dockercompose16194252628685347669
services:
  GameRa.database:
    container_name: GameRa.Database
    environment:
      POSTGRES_DB: GameRa
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\ROSE PC\source\repos\GameFa\containers\db
        target: var/lab/postgresql/data
        bind: {}
  gamera:
    build:
      context: C:\Users\ROSE PC\source\repos\GameFa
      dockerfile: GameFa\Dockerfile
    container_name: GameRa.Api
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
    image: gamera
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "5001"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\ROSE PC\AppData\Roaming/Microsoft/UserSecrets
        target: C:\Users\ContainerUser\AppData\Roaming\Microsoft\UserSecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\ROSE PC\AppData\Roaming/Microsoft/UserSecrets
        target: C:\Users\ContainerAdministrator\AppData\Roaming\Microsoft\UserSecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\ROSE PC\AppData\Roaming/ASP.NET/Https
        target: C:\Users\ContainerUser\AppData\Roaming\ASP.NET\Https
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\ROSE PC\AppData\Roaming/ASP.NET/Https
        target: C:\Users\ContainerAdministrator\AppData\Roaming\ASP.NET\Https
        read_only: true
        bind: {}
networks:
  default:
    name: dockercompose16194252628685347669_default